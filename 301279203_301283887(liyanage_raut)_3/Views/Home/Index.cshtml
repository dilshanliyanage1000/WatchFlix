<div class="login-content-area img-bg">

	<main class="login-container">

		<div class="content-wrapper text-center">

			<h1 class="display-2 mt-2 fw-bold">WatchFlix!</h1>

			<h6 class="mt-1 mb-5">Log in or sign up to see our movie library!</h6>

			<p class="mt-2">Already have an account?</p>

			<a asp-action="Login" asp-controller="Users" class="btn btn-success width-300">
				Sign in
			</a>

			<p class="mt-3">New to WatchFlix?</p>

			<a asp-action="Create" asp-controller="Users" class="btn btn-secondary width-300 mb-3">
				Sign Up
			</a>

		</div>

	</main>

</div>
