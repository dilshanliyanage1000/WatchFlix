@model _301279203_301283887_liyanage_raut__3.Models.LoginUser

<div class="login-content-area img-bg">

    <main class="login-container">

        <div class="content-wrapper">

			<h1 class="display-2 mt-2 fw-bold">WatchFlix!</h1>

            <h6 class="mt-2 mb-5">Log in to see our movie library!</h6>

			<form asp-action="UserLogin" method="post">

				@if (TempData["invalidLogin"] != null)
				{
					<div class="alert alert-danger" role="alert">Invalid username or password!</div>
				}

				<div class="form-group mb-4 text-start">
					<label asp-for="Username" class="form-label">Username</label>
					<input asp-for="Username" class="form-control width-300 custom-tb" placeholder="Enter your username" />
					<span asp-validation-for="Username" class="text-danger"></span>
				</div>

				<div class="form-group mb-4 text-start">
					<label asp-for="UserPassword" class="form-label">Password</label>
					<input asp-for="UserPassword" type="password" class="form-control width-300 custom-tb" placeholder="Enter your password" />
					<span asp-validation-for="UserPassword" class="text-danger"></span>
				</div>

				<button type="submit" class="btn btn-success d-flex justify-content-center width-300">Login</button>

			</form>

			<p class="mt-4">New to WatchFlix?</p>

			<a asp-action="Create" asp-controller="Users" class="btn btn-secondary width-300">
				Sign Up
			</a>

        </div>

    </main>

</div>