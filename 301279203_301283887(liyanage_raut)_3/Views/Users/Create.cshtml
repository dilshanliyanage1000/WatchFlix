@model _301279203_301283887_liyanage_raut__3.Models.User

<div class="login-content-area img-bg">

    <main class="login-container">

        <div class="content-wrapper">

            <h1 class="display-6 mt-2 fw-semibold">Sign Up</h1>

            <h6 class="mt-2 mb-5">Sign up to explore our movie library!</h6>

            <form asp-action="Create" class="text-start">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="FullName" class="control-label">Full Name</label>
                    <input asp-for="FullName" class="form-control width-300 custom-tb" placeholder="Enter your full name" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="form-group mt-4">
                    <label asp-for="Username" class="control-label">Username</label>
                    <input asp-for="Username" class="form-control width-300 custom-tb" placeholder="Enter your username" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="form-group mt-4 mb-4">
                    <label asp-for="UserPassword" class="control-label">Password</label>
                    <input asp-for="UserPassword" type="password" class="form-control width-300 custom-tb" placeholder="Enter your password" />
                    <span asp-validation-for="UserPassword" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <input type="submit" value="Create" class="btn btn-primary width-300" />
                </div>

            </form>

            <p class="mt-3">Already have an account?</p>

            <a asp-action="Login" asp-controller="Users" class="btn btn-success width-300 d-flex justify-content-center">
                Sign in
            </a>

        </div>

    </main>

</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
