@model IEnumerable<_301279203_301283887_liyanage_raut__3.Models.Movie>

<div class="container main-content-area">

    <div class="row align-items-center">
		<h1 class="display-4">Manage your movies</h1>
		<p style="margin-top: 2rem;">Create a new movie?</p>
        <a asp-action="Create" class="btn btn-primary width-300">Create New</a>
    </div>

    <div class="row" style="margin-top: 2rem">

        @foreach (var item in Model)
        {
            <div class="col-md-3 mb-4">
                <div class="card shadow-sm">

                    <a href="@Url.Action("ViewMovie", "Movies", new { id = item.MovieId })" style="padding: 5px;">
                        <img src="https://beanscafe.org/wp-content/uploads/2021/04/Video-Placeholder.jpg" class="card-img-top" alt="Movie Image" style="border-radius: 10px;">
                    </a>

                    <div class="card-body">

                        <h5 class="card-title">@item.Title</h5>

                        <p class="card-text">
                            <strong>Rating:</strong>&nbsp;✰&nbsp;@item.Rating / 10
                            <br />
                            <strong>Genre:</strong> @item.Genre
                            <br />
                            <strong>Director:</strong> @item.Director
                            <br />
                            <strong>Release Date:</strong> @item.ReleaseDate
                        </p>

                        <form asp-action="ViewMovie" asp-controller="Movies" asp-route-id="@item.MovieId">
                            <button class="btn btn-success" style="width: 100%" type="submit">Watch Video</button>
                        </form>

                        <div style="margin-top: 1rem;">
                            <a asp-action="Edit" asp-route-id="@item.MovieId" class="btn btn-warning" style="width: 100%">
                                Edit
                            </a>
						</div>

                        <form asp-action="Delete" style="margin-top: 1rem;" asp-route-id="@item.MovieId" method="post">
                            <button class="btn btn-danger" style="width: 100%" type="submit" onclick="return confirm('Are you sure you want to delete this movie?');">Delete</button>
						</form>
                    
                    </div>
                </div>
            </div>
        }
    
    </div>

</div>
